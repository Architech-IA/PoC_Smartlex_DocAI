# Base de datos (Postgres + pgvector)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smartlex_docai"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/smartlex_docai"

# Ollama — embeddings self-hosted (qwen3-embedding:0.6b, N=1024)
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3-embedding:0.6b"
OLLAMA_EMBEDDING_DIM=1024

# Watcher — carpeta de ingesta en la VPS (Drive montado con rclone)
INGESTA_BASE_PATH="/ruta/al/drive/montado/bandejas"

# Límite de tamaño de documentos (MB)
MAX_DOCUMENTO_MB=15

# Retención de documentos archivados (años)
RETENCION_ANIOS=10

# Obsidian — vault en la VPS (Drive compartido separado, montado con rclone)
OBSIDIAN_VAULT_PATH="/ruta/al/drive/montado/vault"

# Notion — token de solo lectura (paso pendiente del usuario; el código funciona sin él)
NOTION_TOKEN=
NOTION_SYNC_INTERVAL_HOURS=6
